<mujoco model="dual ScaleBFM sim2sim">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" integrator="implicit" iterations="10"
          ls_iterations="20" gravity="0 0 -9.81"/>
  <size nconmax="256" njmax="2400"/>
  <statistic center="0 0 0.85" extent="2.2"/>

  <visual>
    <headlight diffuse="0.72 0.72 0.72" ambient="0.22 0.22 0.22"
               specular="0.15 0.15 0.15"/>
    <global azimuth="140" elevation="-15"/>
  </visual>

  <asset>
    <!-- Dual_G1_MJ omnicontact-hand collisions (16 meshes per hand),
         with deployment reflected armatures and torque motors. -->
    <model name="robot_a_model" file="g1_scalebfm_training.xml"/>
    <model name="robot_b_model" file="g1_scalebfm_training.xml"/>
    <texture type="skybox" builtin="flat" rgb1="0.025 0.035 0.045"
             rgb2="0.025 0.035 0.045" width="512" height="3072"/>
    <texture name="floor_texture" type="2d" builtin="checker" mark="edge"
             rgb1="0.18 0.20 0.21" rgb2="0.10 0.11 0.12"
             markrgb="0.34 0.36 0.37" width="512" height="512"/>
    <material name="floor_material" texture="floor_texture" texuniform="true"
              texrepeat="8 8" reflectance="0.08"/>
  </asset>

  <worldbody>
    <light name="key" directional="true" pos="1 -2 4" dir="-0.2 0.25 -1"/>
    <geom name="floor" type="plane" size="0 0 0.05"
          material="floor_material" friction="0.9 0.005 0.0001"/>

    <attach model="robot_a_model" body="pelvis" prefix="a_"/>
    <attach model="robot_b_model" body="pelvis" prefix="b_"/>

    <!-- Deterministic-play object from motion_000000.npz: 0.8165865 x 0.3 x
         0.3 m, 0.5 kg, with the same contact dimensions and friction. -->
    <body name="box">
      <freejoint name="box_joint"/>
      <inertial pos="0 0 0" mass="1.5"
                diaginertia="0.0075 0.03153390 0.03153390"/>
      <geom name="box_collision" type="box" size="0.40829325 0.15 0.15"
            friction="0.9 0.5 0.001" condim="6" rgba="0.70 0.80 0.90 1"/>
    </body>
  </worldbody>
</mujoco>
