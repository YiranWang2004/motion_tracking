<mujoco model="dual ScaleBFM real-time twin">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 0" timestep="0.02"/>
  <statistic center="0 0.45 0.85" extent="1.8"/>

  <visual>
    <headlight diffuse="0.72 0.72 0.72" ambient="0.22 0.22 0.22" specular="0.15 0.15 0.15"/>
    <rgba haze="0.08 0.11 0.14 1"/>
    <global azimuth="-135" elevation="-18"/>
  </visual>

  <asset>
    <!-- Each attachment receives a prefix, including joints, bodies, meshes,
         actuators, and sensors. This keeps all four G1 instances independent. -->
    <model name="actual_a_model" file="g1_29dof.xml"/>
    <model name="actual_b_model" file="g1_29dof.xml"/>
    <model name="reference_a_model" file="g1_29dof.xml"/>
    <model name="reference_b_model" file="g1_29dof.xml"/>
    <texture type="skybox" builtin="flat" rgb1="0.025 0.035 0.045" rgb2="0.025 0.035 0.045" width="512" height="3072"/>
    <texture name="twin_floor_texture" type="2d" builtin="checker" mark="edge"
             rgb1="0.18 0.20 0.21" rgb2="0.10 0.11 0.12" markrgb="0.34 0.36 0.37"
             width="512" height="512"/>
    <material name="twin_floor_material" texture="twin_floor_texture"
              texuniform="true" texrepeat="8 8" reflectance="0.08"/>
  </asset>

  <worldbody>
    <light name="twin_key" directional="true" pos="1 -2 4" dir="-0.2 0.25 -1"
           diffuse="0.8 0.8 0.78" specular="0.08 0.08 0.08"/>
    <geom name="twin_floor" type="plane" size="0 0 0.05" material="twin_floor_material"
          contype="0" conaffinity="0"/>

    <attach model="actual_a_model" body="pelvis" prefix="actual_a_"/>
    <attach model="actual_b_model" body="pelvis" prefix="actual_b_"/>
    <attach model="reference_a_model" body="pelvis" prefix="reference_a_"/>
    <attach model="reference_b_model" body="pelvis" prefix="reference_b_"/>

    <body name="actual_box">
      <freejoint name="actual_box_joint"/>
      <inertial pos="0 0 0" mass="1" diaginertia="0.02 0.02 0.02"/>
      <geom name="actual_box_geom" type="box" size="0.30 0.15 0.15"
            rgba="0.82 0.57 0.20 0.92" contype="0" conaffinity="0" density="0"/>
    </body>
    <body name="reference_box">
      <freejoint name="reference_box_joint"/>
      <inertial pos="0 0 0" mass="1" diaginertia="0.02 0.02 0.02"/>
      <geom name="reference_box_geom" type="box" size="0.30 0.15 0.15"
            rgba="0.20 0.88 0.46 0.30" contype="0" conaffinity="0" density="0" group="1"/>
    </body>

    <!-- Calibrated Tracker-derived poses. The axes make A/B/object routing
         errors visible without using the robot command path. -->
    <body name="tracker_a_marker" mocap="true">
      <geom type="sphere" size="0.025" rgba="0.10 0.72 1 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0.18 0 0" size="0.006" rgba="1 0.12 0.12 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0.18 0" size="0.006" rgba="0.12 1 0.18 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.18" size="0.006" rgba="0.12 0.40 1 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tracker_b_marker" mocap="true">
      <geom type="sphere" size="0.025" rgba="1 0.72 0.12 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0.18 0 0" size="0.006" rgba="1 0.12 0.12 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0.18 0" size="0.006" rgba="0.12 1 0.18 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.18" size="0.006" rgba="0.12 0.40 1 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tracker_object_marker" mocap="true">
      <geom type="sphere" size="0.022" rgba="0.95 0.32 0.18 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0.16 0 0" size="0.005" rgba="1 0.12 0.12 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0.16 0" size="0.005" rgba="0.12 1 0.18 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.16" size="0.005" rgba="0.12 0.40 1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
