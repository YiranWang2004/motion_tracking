<mujoco model="dual ScaleBFM real-time twin">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 0" timestep="0.02"/>
  <statistic center="0 0.45 0.85" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <!-- Each attachment receives a prefix, including joints, bodies, meshes,
         actuators, and sensors. This keeps all four G1 instances independent. -->
    <model name="actual_a_model" file="g1_29dof.xml"/>
    <model name="actual_b_model" file="g1_29dof.xml"/>
    <model name="reference_a_model" file="g1_29dof.xml"/>
    <model name="reference_b_model" file="g1_29dof.xml"/>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture name="twin_floor_texture" type="2d" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="twin_floor_material" texture="twin_floor_texture"
              texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <mesh name="twin_tracker_pyramid"
          vertex="-0.05 -0.0288675135 0  0.05 -0.0288675135 0  0 0.057735027 0  0 0 -0.1"
          face="0 1 2  0 3 1  1 3 2  2 3 0"/>
    <material name="twin_tracker_a" rgba="0.10 0.45 1 1"/>
    <material name="twin_tracker_b" rgba="0.65 0.25 1 1"/>
    <material name="twin_tracker_object" rgba="1 0.35 0.06 1"/>
  </asset>

  <worldbody>
    <light name="twin_key" directional="true" pos="1 0 3.5" dir="0 0 -1"/>
    <light name="twin_fill" pos="-2 1 3" dir="2 -1 -3"
           diffuse="0.8 0.85 1" specular="0.15 0.15 0.15"/>
    <geom name="twin_floor" type="plane" size="0 0 0.05" material="twin_floor_material"
          contype="0" conaffinity="0"/>

    <!-- Task world frame: X=red, Y=green, Z=blue. Visual only. -->
    <geom name="world_frame_origin" type="sphere" pos="0 0 0" size="0.014"
          rgba="1 0.85 0.1 1" contype="0" conaffinity="0" group="2" density="0"/>
    <geom name="world_frame_axis_x" type="capsule" fromto="0 0 0 0.45 0 0" size="0.007"
          rgba="0.95 0.08 0.08 1" contype="0" conaffinity="0" group="2" density="0"/>
    <geom name="world_frame_axis_y" type="capsule" fromto="0 0 0 0 0.45 0" size="0.007"
          rgba="0.08 0.90 0.18 1" contype="0" conaffinity="0" group="2" density="0"/>
    <geom name="world_frame_axis_z" type="capsule" fromto="0 0 0 0 0 0.45" size="0.007"
          rgba="0.10 0.38 1 1" contype="0" conaffinity="0" group="2" density="0"/>

    <attach model="actual_a_model" body="pelvis" prefix="actual_a_"/>
    <attach model="actual_b_model" body="pelvis" prefix="actual_b_"/>
    <attach model="reference_a_model" body="pelvis" prefix="reference_a_"/>
    <attach model="reference_b_model" body="pelvis" prefix="reference_b_"/>

    <body name="actual_box">
      <freejoint name="actual_box_joint"/>
      <inertial pos="0 0 0" mass="1" diaginertia="0.02 0.02 0.02"/>
      <geom name="actual_box_geom" type="box" size="0.30 0.15 0.15"
            rgba="0.8 0.6 0.4 1" contype="0" conaffinity="0" density="0"/>
      <!-- Measured box local frame, matching the single-robot carry-box scene. -->
      <geom name="box_frame_origin" type="sphere" size="0.012" rgba="1 0.85 0.1 1"
            contype="0" conaffinity="0" group="2" density="0"/>
      <geom name="box_frame_axis_x" type="capsule" fromto="0 0 0 0.28 0 0" size="0.006"
            rgba="0.95 0.08 0.08 1" contype="0" conaffinity="0" group="2" density="0"/>
      <geom name="box_frame_axis_y" type="capsule" fromto="0 0 0 0 0.28 0" size="0.006"
            rgba="0.08 0.90 0.18 1" contype="0" conaffinity="0" group="2" density="0"/>
      <geom name="box_frame_axis_z" type="capsule" fromto="0 0 0 0 0 0.28" size="0.006"
            rgba="0.10 0.38 1 1" contype="0" conaffinity="0" group="2" density="0"/>
    </body>
    <body name="reference_box">
      <freejoint name="reference_box_joint"/>
      <inertial pos="0 0 0" mass="1" diaginertia="0.02 0.02 0.02"/>
      <geom name="reference_box_geom" type="box" size="0.30 0.15 0.15"
            rgba="0.9 0.3 0 0.7" contype="0" conaffinity="0" density="0" group="1"/>
    </body>

    <!-- Direct Vive mode places these at raw Tracker origins. Replay and
         --no-vive mode reconstruct them from calibrated policy poses.
         Pyramids and axes intentionally match the single-robot viewer style. -->
    <body name="tracker_a_marker" mocap="true">
      <geom name="tracker_a_marker_geom" type="mesh" mesh="twin_tracker_pyramid"
            material="twin_tracker_a" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0.22 0 0" size="0.006" rgba="0.95 0.08 0.08 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0.22 0" size="0.006" rgba="0.08 0.90 0.18 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.22" size="0.006" rgba="0.10 0.38 1 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tracker_b_marker" mocap="true">
      <geom name="tracker_b_marker_geom" type="mesh" mesh="twin_tracker_pyramid"
            material="twin_tracker_b" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0.22 0 0" size="0.006" rgba="0.95 0.08 0.08 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0.22 0" size="0.006" rgba="0.08 0.90 0.18 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.22" size="0.006" rgba="0.10 0.38 1 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tracker_object_marker" mocap="true">
      <geom name="tracker_object_marker_geom" type="mesh" mesh="twin_tracker_pyramid"
            material="twin_tracker_object" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0.22 0 0" size="0.006" rgba="0.95 0.08 0.08 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0.22 0" size="0.006" rgba="0.08 0.90 0.18 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.22" size="0.006" rgba="0.10 0.38 1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
